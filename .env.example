# App identity — used as the `appName` on every audit log entry. Change when
# forking this template for a new business system. (The MCP server's name comes
# from backend/package.json's `name` field instead, not this env var.)
APP_NAME=appspine-app-template

# Cross-app MCP tool naming prefix (@appspine/mcp-server, dev_docs 002/023 §2.2) — every
# @McpTool() this app registers gets dual-registered under both its bare name and
# <prefix>_<name>, so external callers (n8n, AI agents) can tell which app a tool belongs
# to from a flattened cross-app tool list. Set this to the app's short name when forking
# (e.g. `wiki`, `calendar`) — must match `[a-zA-Z0-9_-]+`. Forks off this template start
# with the prefix already set, so there's no dual-registration transition window for them.
MCP_TOOL_PREFIX=appspine-app-template

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
# DB_PORT is picked up by docker-compose to bind the host port.
# DATABASE_URL must be kept in sync with it manually (dotenv doesn't
# interpolate variables across keys).
DB_PORT=23900
DATABASE_URL=postgresql://postgres:changeme@localhost:23900/app_db

# Auth — OIDC-only (dev_docs/framework/035), points at the shared dev Keycloak
# (dev-infra/README.md at the repo root). OidcStrategy looks the user up locally by
# email afterward for RBAC grants (JIT-provisions on first login if no local User
# exists yet). JWT_SECRET is legacy local-auth infra @appspine/auth still requires at
# boot; unused otherwise.
AUTH_MODE=oidc
JWT_SECRET=dev-secret
OIDC_JWKS_URL=http://localhost:8180/realms/appspine-dev/protocol/openid-connect/certs
OIDC_ISSUER=http://localhost:8180/realms/appspine-dev
# FORK REQUIREMENT: register this app as a new client in dev-infra's appspine-dev realm
# (client ID = this app's folder name — see dev-infra/README.md "Adding a 10th app" for
# the audience/email mapper + access-group setup), then set the client ID here.
OIDC_AUDIENCE=<client-id>

# CORS Configuration (matches FRONTEND_PORT)
CORS_ORIGINS=http://localhost:3901

# Ports
PORT=3900
BACKEND_PORT=3900
FRONTEND_PORT=3901
NEXT_PUBLIC_API_URL=http://localhost:3900

# Seed user (used by pnpm -C backend prisma:seed) — pre-assigns ADMIN to this email so
# it's ready to go on first OIDC login. Local auth is retired (dev_docs/framework/035);
# there is no password to set here, the IdP authenticates.
SEED_USER_EMAIL=admin@example.com
SEED_USER_NAME=Admin

# 023 discovery service catalog push (@appspine/mcp-server DiscoveryPushService, T-9700) —
# opt-in: unset either DISCOVERY_PUSH_URL or DISCOVERY_PUSH_TOKEN to disable. On boot, this
# app pushes its MCP tool catalog (name/description/scopes/readOnlyHint per tool) to the 023
# discovery service (dev_docs 023 §2.1) so external callers (n8n, AI agents) can find where
# this app's MCP endpoint lives without polling every app individually. DISCOVERY_PUSH_TOKEN
# is minted per app by a discovery-service admin via `POST /discovery/apps` — it is shown
# once at registration time and is NOT this file's job to hold a real value; only fill it
# into your local (gitignored) .env, never here. PUBLIC_BASE_URL is this app's own
# externally-reachable base URL (mcp/metadata endpoints are derived from it as
# `<PUBLIC_BASE_URL>/mcp` and `<PUBLIC_BASE_URL>/metadata/schema`).
DISCOVERY_PUSH_URL=http://localhost:3070
DISCOVERY_PUSH_TOKEN=
PUBLIC_BASE_URL=http://localhost:3900

# @appspine/domain-events dispatcher tuning (dev_docs 002 "Domain Events 使用慣例"; see
# docs/domain-events.md). The registry ships empty — these only matter once you register your
# first event/handler. Defaults are sane for local dev; leave unset to use them.
# DOMAIN_EVENTS_DISPATCH_INTERVAL_MS=5000
# DOMAIN_EVENTS_BATCH_SIZE=20
# DOMAIN_EVENTS_MAX_ATTEMPTS=8
# DOMAIN_EVENTS_STALE_LOCK_MS=300000

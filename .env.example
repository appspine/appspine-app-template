# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@localhost:23900/app_db

# Auth — see dev_docs/001-app-framework-plan.md "身份/權限細節" in the apptara workspace.
# Not wired yet (see src/app.module.ts) — placeholder for when @apptara/auth lands.
AUTH_MODE=local
# OIDC mode points at an existing external IdP (Keycloak), not a framework-owned service:
# OIDC_JWKS_URL=https://keycloak.example.com/realms/<realm>/protocol/openid-connect/certs
# OIDC_ISSUER=https://keycloak.example.com/realms/<realm>

# CORS Configuration (matches FRONTEND_PORT)
CORS_ORIGINS=http://localhost:3901

# Ports
PORT=3900
BACKEND_PORT=3900
FRONTEND_PORT=3901
NEXT_PUBLIC_API_URL=http://localhost:3900

# Seed user (local auth only — used by pnpm -C backend prisma:seed)
SEED_USER_EMAIL=admin@example.com
SEED_USER_NAME=Admin

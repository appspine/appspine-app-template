{
  "name": "appspine-app-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "preinstall": "node scripts/check-registry-auth.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:integration-contracts": "node scripts/check-generated-integration-contracts.mjs",
    "dev": "dotenv -e .env -- concurrently -n back,front -c blue,green \"pnpm -C backend dev\" \"pnpm -C frontend dev\"",
    "dev:backend": "pnpm -C backend dev",
    "dev:frontend": "pnpm -C frontend dev",
    "typecheck": "pnpm -C backend typecheck && pnpm -C frontend typecheck",
    "check": "biome check backend/src frontend/src",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "concurrently": "^9.1.0",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "@appspine/plugin-api": "^1.1.0",
    "@appspine/plugin-host-nest": "^2.0.0",
    "@appspine/plugin-cli": "^2.0.0",
    "@appspine/plugin-testkit": "^2.0.0",
    "@appspine/preset-standard": "^2.0.0",
    "@appspine/common": "^0.3.4",
    "@appspine/audit-log": "^1.1.0",
    "@appspine/health-check": "^1.0.0",
    "@appspine/identity-core": "^2.0.0",
    "@appspine/rbac": "^5.0.0",
    "@appspine/oidc-auth": "^2.0.0",
    "@appspine/m2m-api-key": "^6.0.0",
    "@appspine/metadata-schema": "^1.0.0",
    "@appspine/notification": "^1.0.0",
    "@appspine/domain-events": "^9.0.0",
    "@appspine/mcp-server": "^1.0.0",
    "@appspine/oidc-delegation": "^0.4.0",
    "@appspine/master-data-client": "^0.2.0",
    "@appspine/frontend-shell": "^0.17.0",
    "@appspine/e2e-kit": "^1.0.2",
    "@appspine/integration-contracts": "^0.4.0"
  }
}

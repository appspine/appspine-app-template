@appspine:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# @appspine/* are private packages published by this same org, not public npm -
# the supply-chain risk this guards against (freshly-published malicious packages)
# doesn't apply here, and the default 24h window blocks CI right after any release.
minimumReleaseAge=0

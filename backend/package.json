{
  "name": "@app/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../.env -- nest start --watch",
    "build": "nest build",
    "start": "dotenv -e ../.env -- node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "biome check src",
    "prisma:generate": "dotenv -e ../.env -- prisma generate --schema prisma/schema",
    "prisma:migrate": "dotenv -e ../.env -- prisma migrate dev --schema prisma/schema",
    "prisma:deploy": "dotenv -e ../.env -- prisma migrate deploy --schema prisma/schema",
    "prisma:seed": "dotenv -e ../.env -- prisma db seed",
    "prisma:studio": "dotenv -e ../.env -- prisma studio --schema prisma/schema",
    "schema:docs": "dotenv -e ../.env -- ts-node scripts/gen-data-dictionary.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@appspine/audit-log": "^0.1.0",
    "@appspine/auth": "^0.1.2",
    "@appspine/common": "^0.1.0",
    "@appspine/health-check": "^0.1.0",
    "@appspine/m2m-api-key": "^0.1.2",
    "@appspine/mcp-server": "^0.1.2",
    "@appspine/metadata-schema": "^0.2.0",
    "@appspine/rbac": "^0.3.0",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.5",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/client": "^6.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}

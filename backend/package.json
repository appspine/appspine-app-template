{
  "name": "@app/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../.env -- nest start --watch",
    "build": "nest build",
    "appspine:build": "appspine build",
    "appspine:check": "appspine build --check",
    "appspine:doctor": "dotenv -e ../.env -- appspine doctor",
    "start": "dotenv -e ../.env -- node dist/src/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "biome check src",
    "test": "vitest run",
    "prisma:generate": "dotenv -e ../.env -- prisma generate --schema prisma/schema",
    "prisma:migrate": "dotenv -e ../.env -- prisma migrate dev --schema prisma/schema",
    "prisma:deploy": "dotenv -e ../.env -- prisma migrate deploy --schema prisma/schema",
    "prisma:seed": "dotenv -e ../.env -- prisma db seed",
    "prisma:studio": "dotenv -e ../.env -- prisma studio --schema prisma/schema",
    "check:enum-i18n": "dotenv -e ../.env -- ts-node scripts/check-enum-i18n.ts",
    "check:schema-docs": "dotenv -e ../.env -- ts-node scripts/check-schema-docs.ts",
    "check:domain-events-schema-drift": "dotenv -e ../.env -- ts-node scripts/check-domain-events-schema-drift.ts",
    "check:notification-schema-drift": "dotenv -e ../.env -- ts-node scripts/check-notification-schema-drift.ts",
    "check:domain-events-subscribers": "dotenv -e ../.env -- ts-node scripts/check-domain-events-subscribers.ts",
    "check:scope-guard-coverage": "ts-node scripts/check-scope-guard-coverage.ts",
    "schema:docs": "dotenv -e ../.env -- ts-node scripts/gen-data-dictionary.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@appspine/audit-log": "^1.1.0",
    "@appspine/common": "^0.3.4",
    "@appspine/domain-events": "^9.0.0",
    "@appspine/health-check": "^1.0.0",
    "@appspine/identity-core": "^2.0.0",
    "@appspine/integration-contracts": "^0.4.0",
    "@appspine/m2m-api-key": "^6.0.0",
    "@appspine/mcp-server": "^1.0.0",
    "@appspine/metadata-schema": "^1.0.0",
    "@appspine/notification": "^1.0.0",
    "@appspine/oidc-auth": "^2.0.0",
    "@appspine/plugin-api": "^1.1.0",
    "@appspine/plugin-host-nest": "^2.0.0",
    "@appspine/preset-standard": "^2.0.0",
    "@appspine/rbac": "^5.0.0",
    "@nestjs/common": "^11.0.5",
    "@nestjs/core": "^11.0.5",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.5",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/client": "^6.2.0",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@appspine/plugin-cli": "^2.0.0",
    "@appspine/plugin-testkit": "^2.0.0",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^11.0.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}

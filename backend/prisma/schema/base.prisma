// User/Role/RolePermission/UserRole/ApiKey/AuditLog all come from @appspine/*
// package Prisma fragments (user.prisma/role.prisma/api-key.prisma/audit-log.prisma
// in this folder — copied from @appspine/identity-core, @appspine/rbac, @appspine/m2m-api-key,
// @appspine/audit-log respectively at scaffold time, then independently editable).
//
// `Permission` is the one piece NOT shipped by any package — the permission catalog
// grows per app as CRUD modules are added (dev_docs 002 "新增 CRUD 模組標準流程"),
// so it lives here and only here.

/// Granular permission assignable to a custom Role. ADMIN bypasses all checks;
/// these values are only evaluated for non-ADMIN roles. Embedded in the JWT at login.
enum Permission {
  // User management
  USERS_READ
  USERS_CREATE
  USERS_UPDATE
  USERS_DELETE
  // API key management
  API_KEYS_READ
  API_KEYS_CREATE
  API_KEYS_DELETE
}
